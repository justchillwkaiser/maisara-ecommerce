# MAISARA — persekitaran
# Salin ke .env dan isi nilai sebenar. Jangan commit .env.

# --- Pangkalan data ---------------------------------------------------------
# Postgres (Supabase pooler). Diperlukan oleh Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# --- Auth -------------------------------------------------------------------
# Rahsia Better Auth — WAJIB dalam produksi. Jana dengan: openssl rand -base64 32
# (Nama lama AUTH_SECRET masih dibaca sebagai sandaran.)
BETTER_AUTH_SECRET=""
# URL asas aplikasi (callback auth, pautan reset kata laluan, trustedOrigins).
# Jika kosong, nilai diambil daripada NEXT_PUBLIC_SITE_URL, kemudian
# VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL, dan akhirnya localhost:3000.
# Untuk produksi, tetapkan salah satu daripada nilai tersebut kepada domain
# sebenar — jangan biarkan lalai localhost.
BETTER_AUTH_URL="http://localhost:3000"

# --- Laman ------------------------------------------------------------------
# Digunakan untuk metadata SEO, canonical URL, sitemap dan robots.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Pembayaran -------------------------------------------------------------
# Penyedia pembayaran. "mock" untuk demo tanpa PSP sebenar.
PAYMENT_PROVIDER="mock"

# --- Hubungan ---------------------------------------------------------------
# Inbox sebenar yang menerima mesej borang Hubungi Kami dan langganan
# Newsletter. Semua topik menggunakan alamat ini melainkan alamat khusus
# diberikan di bawah.
NEXT_PUBLIC_CONTACT_EMAIL="salam@maisara.my"
# Pilihan: alamat khusus setiap topik. Kosongkan untuk guna alamat utama.
NEXT_PUBLIC_CONTACT_EMAIL_CARE=""
NEXT_PUBLIC_CONTACT_EMAIL_ORDER=""
NEXT_PUBLIC_CONTACT_EMAIL_COLLAB=""
NEXT_PUBLIC_CONTACT_EMAIL_WHOLESALE=""

# --- Penghantaran e-mel -----------------------------------------------------
# Apabila RESEND_API_KEY ditetapkan, borang Hubungi Kami dan Newsletter
# menghantar e-mel sebenar. Tanpa kunci ini, kedua-dua borang memulangkan
# keadaan "belum diaktifkan" dan memaparkan alamat e-mel terus kepada
# pelanggan - mereka TIDAK pernah melaporkan kejayaan palsu.
RESEND_API_KEY=""
EMAIL_FROM="MAISARA <salam@maisara.my>"

# --- Sosial -----------------------------------------------------------------
# Hanya dipaparkan dalam footer apabila ditetapkan. Biarkan kosong jika
# akaun belum wujud - footer tidak akan memaparkan pautan mati.
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_TIKTOK_URL=""

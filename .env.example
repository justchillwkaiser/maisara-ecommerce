# Environment variables - salin ke .env dan isi nilai sebenar
# DATABASE_URL: connection string Prisma (Neon/Supabase Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/maisara"
# AUTH_SECRET: generate dengan `npx better-auth secret` atau openssl rand -base64 32
AUTH_SECRET=""
# PAYMENT_PROVIDER: "mock" untuk development, "stripe" / "toyyibpay" untuk production
PAYMENT_PROVIDER="mock"

# Environment variables - salin ke .env dan isi nilai sebenar
# DATABASE_URL: connection string Prisma (Neon/Supabase Postgres)
# Nota local Windows: guna Supabase pooler (direct host IPv6-only tak boleh resolve).
# Format pooler: postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=no-verify
DATABASE_URL="postgresql://user:***@localhost:5432/maisara"
# AUTH_SECRET: generate dengan `npx better-auth secret` atau openssl rand -base64 32
AUTH_SECRET=""
# BETTER_AUTH_URL: URL app (local: http://localhost:3000; production: domain deploy)
BETTER_AUTH_URL="http://localhost:3000"
# NEXT_PUBLIC_SITE_URL: URL public untuk metadata/OG/sitemap (optional; fallback ke Vercel URL)
NEXT_PUBLIC_SITE_URL=""
# PAYMENT_PROVIDER: "mock" untuk development, "stripe" / "toyyibpay" untuk production
PAYMENT_PROVIDER="mock"
